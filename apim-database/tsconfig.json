{
    "compilerOptions": {
        "target": "ESNext",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "types": [
            "node"
        ],
        "strict": true,
        "skipLibCheck": true,
        "outDir": "./dist",
        "esModuleInterop": true,
        "allowJs": true,
        "resolveJsonModule": true
    },
    "include": [
        "scripts/**/*.ts",
        "schema/**/*.sql"
    ]
}