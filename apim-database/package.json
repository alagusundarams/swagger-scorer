{
    "name": "apim-database",
    "version": "1.0.0",
    "description": "Database scripts and schema for APIM Portal",
    "type": "module",
    "scripts": {
        "setup": "tsx scripts/setup-db.ts",
        "seed": "tsx scripts/utils/seed-demo.ts",
        "sync": "tsx scripts/core/discover-sync.ts",
        "sync:fast": "tsx scripts/core/discover-sync.ts --skip-ado",
        "sync:db": "tsx scripts/core/discover-sync.ts --source=db",
        "ado": "tsx scripts/core/extract-ado-metadata.ts",
        "reconcile": "tsx scripts/core/reconcile-governance.ts",
        "verify": "tsx scripts/debug/verify-backend-queries.ts",
        "verify:operations": "tsx scripts/debug/verify-operations.ts",
        "inspect": "tsx scripts/debug/inspect-schema.ts",
        "orphans": "tsx scripts/core/generate-orphaned-report.ts",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "main": "index.js",
    "dependencies": {
        "hcl2-parser": "^1.0.3",
        "node-fetch": "^3.3.2",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@types/node": "^20.19.27",
        "@types/pg": "^8.11.0",
        "axios": "^1.13.2",
        "dotenv": "^17.2.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}