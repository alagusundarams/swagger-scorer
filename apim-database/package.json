{
    "name": "apim-database",
    "version": "1.0.0",
    "description": "Database scripts and schema for APIM Portal",
    "type": "module",
    "scripts": {
        "setup": "tsx scripts/setup-db.ts 2>&1 | tee \"scripts/logs/setup_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "seed": "tsx scripts/utils/seed-demo.ts 2>&1 | tee \"scripts/logs/seed_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "sync": "tsx scripts/core/discover-sync.ts 2>&1 | tee \"scripts/logs/sync_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "sync:fast": "tsx scripts/core/discover-sync.ts --skip-ado 2>&1 | tee \"scripts/logs/sync-fast_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "sync:db": "tsx scripts/core/discover-sync.ts --source=db 2>&1 | tee \"scripts/logs/sync-db_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "extract-apim": "tsx scripts/core/extract-apim-inventory.ts 2>&1 | tee \"scripts/logs/extract-apim_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "ado": "tsx scripts/core/extract-ado-metadata.ts 2>&1 | tee \"scripts/logs/ado_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "reconcile": "tsx scripts/core/reconcile-governance.ts 2>&1 | tee \"scripts/logs/reconcile_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "verify": "tsx scripts/debug/verify-backend-queries.ts 2>&1 | tee \"scripts/logs/verify_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "verify:operations": "tsx scripts/debug/verify-operations.ts 2>&1 | tee \"scripts/logs/verify-operations_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "inspect": "tsx scripts/debug/inspect-schema.ts 2>&1 | tee \"scripts/logs/inspect_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "orphans": "tsx scripts/core/generate-orphaned-report.ts 2>&1 | tee \"scripts/logs/orphans_$(date +%m-%d-%Y--%H-%M-%S).log\"",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "main": "index.js",
    "dependencies": {
        "hcl2-parser": "^1.0.3",
        "node-fetch": "^3.3.2",
        "pg": "^8.16.3"
    },
    "devDependencies": {
        "@types/node": "^20.19.27",
        "@types/pg": "^8.11.0",
        "axios": "^1.13.2",
        "dotenv": "^17.2.3",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    }
}